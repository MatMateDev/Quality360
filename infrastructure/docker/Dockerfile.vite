# Quality360 · Imagen multi-stage para el portal Vite (apps/web), servido como
# estático con nginx.
#
# Se construye SIEMPRE con el contexto en la raíz del monorepo (por eso
# docker-compose.yml usa `context: ..`), porque necesita el `package.json` y
# el `package-lock.json` raíz para instalar con npm workspaces.
#
# Uso manual:
#   docker build -f infrastructure/docker/Dockerfile.vite \
#     --build-arg WORKSPACE=apps/web \
#     --build-arg VITE_SUPABASE_URL=http://127.0.0.1:54321 \
#     --build-arg VITE_SUPABASE_ANON_KEY=... \
#     --build-arg VITE_GATEWAY_URL=http://localhost:3000 \
#     -t q360/web .
#
# Vite incrusta las variables VITE_* en el bundle en tiempo de build (no en
# runtime), por eso viajan como ARG/ENV de la etapa de build, nunca como
# secretos: el portal solo recibe la URL y la clave PÚBLICA de Supabase
# (regla no negociable 6).

ARG NODE_VERSION=24-alpine

FROM node:${NODE_VERSION} AS deps
WORKDIR /repo
ENV NPM_CONFIG_FUND=false NPM_CONFIG_AUDIT=false
COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
RUN npm ci

FROM deps AS build
ARG WORKSPACE
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_GATEWAY_URL
ENV VITE_SUPABASE_URL=${VITE_SUPABASE_URL} \
    VITE_SUPABASE_ANON_KEY=${VITE_SUPABASE_ANON_KEY} \
    VITE_GATEWAY_URL=${VITE_GATEWAY_URL}
RUN test -n "$WORKSPACE" || (echo "Falta --build-arg WORKSPACE=<ruta-del-workspace>" >&2 && exit 1)
RUN npm run build --workspace "${WORKSPACE}"

FROM nginx:1.27-alpine AS runner
ARG WORKSPACE
COPY infrastructure/docker/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build "/repo/${WORKSPACE}/dist" /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
  CMD wget -qO- "http://127.0.0.1:80/health" || exit 1

CMD ["nginx", "-g", "daemon off;"]
