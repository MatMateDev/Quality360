# Quality360 · Variables de entorno (ejemplo, sin valores reales)
# Copia este archivo a `.env` y completa los valores. `.env` nunca se versiona.
#
# Los valores locales de Supabase se obtienen con:
#   cd infrastructure && npm run supabase:status
# (equivale a `npx supabase status -o env`; no pegues esos valores aquí, van
# solo en tu `.env` local).
#
# Ver infrastructure/README.md para el detalle de cada bloque y el paso a
# nube (Render/Railway + Supabase alojado).

# --- Supabase local (D3, D8) -------------------------------------------------
# API_URL de Supabase (Kong). Local: http://127.0.0.1:54321
SUPABASE_URL=
# Clave pública del proyecto. Local: PUBLISHABLE_KEY (sb_publishable_...) o,
# en formato legado, ANON_KEY (JWT). El front y el gateway solo reciben esta.
SUPABASE_ANON_KEY=
# Clave secreta, solo para el backend que administra usuarios de Auth
# (organizacion). Local: SECRET_KEY (sb_secret_...) o, en formato legado,
# SERVICE_ROLE_KEY (JWT). Nunca se usa como rol de conexión a Postgres.
SUPABASE_SERVICE_ROLE_KEY=
# Secreto HS256 con el que Supabase Auth firma los JWT locales. Lo usa el
# gateway para verificar sesiones sin llamar a Supabase en cada request.
SUPABASE_JWT_SECRET=

# --- Conexión a Postgres, una por servicio (D3, D5) --------------------------
# Cada URL usa el rol de login propio del servicio (svc_organizacion, etc.),
# nunca `postgres` ni `service_role`. Local: host.docker.internal:54322 desde
# los contenedores de Compose, o 127.0.0.1:54322 fuera de Compose.
DATABASE_URL_ORGANIZACION=
DATABASE_URL_CERTIFICACIONES=
DATABASE_URL_IMPEDIMENTOS=
DATABASE_URL_INTEGRACIONES=

# --- Descubrimiento de servicios internos (usados por el gateway) -----------
ORGANIZACION_URL=http://organizacion:3001
CERTIFICACIONES_URL=http://certificaciones:3002
IMPEDIMENTOS_URL=http://impedimentos:3003
INTEGRACIONES_URL=http://integraciones:3004

# --- Fuentes de los bloques compuestos del portal QE (regla no negociable 4) -
# Una URL por bloque, para que QA pueda simular la caída de una sola fuente
# (por ejemplo, apuntar FUENTE_RESUMEN_HDU_URL a un puerto inexistente).
# Por defecto ambas apuntan a Organización.
FUENTE_RESUMEN_EQUIPO_URL=http://organizacion:3001
FUENTE_RESUMEN_HDU_URL=http://organizacion:3001

# --- Seguridad entre servicios (gateway <-> servicios internos) -------------
# Token compartido que el gateway agrega a cada llamada interna y que cada
# servicio valida antes de confiar en el encabezado de usuario/rol.
X_Q360_SERVICIO_TOKEN=

# --- Carga semilla (servicio integraciones) ----------------------------------
# Habilita el endpoint/-script de carga semilla. En false por defecto; solo se
# enciende en local o en el runner de CI, nunca en un entorno con datos reales.
PERMITIR_CARGA_SEMILLA=false

# --- Frontend (Vite) ----------------------------------------------------------
# Vite solo expone variables con prefijo VITE_. El portal nunca recibe la
# clave secreta ni las DATABASE_URL.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GATEWAY_URL=http://localhost:3000

# --- Puertos (Compose) ---------------------------------------------------
PORT_WEB=8080
PORT_GATEWAY=3000
PORT_ORGANIZACION=3001
PORT_CERTIFICACIONES=3002
PORT_IMPEDIMENTOS=3003
PORT_INTEGRACIONES=3004
