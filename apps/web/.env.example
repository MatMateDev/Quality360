# Copia este archivo a .env.local (no se versiona) y completa los valores.
# Solo estas tres variables llegan al front (ADR 0006).

# URL del proyecto Supabase (nube o `supabase start` local).
VITE_SUPABASE_URL=http://localhost:54321

# Clave pública de Supabase: acepta el formato nuevo (sb_publishable_...)
# o la ANON_KEY legacy. Nunca la service role key.
VITE_SUPABASE_ANON_KEY=

# URL del gateway público (apps/gateway).
VITE_GATEWAY_URL=http://localhost:3000

# Modo mock: activa MSW y omite Supabase para iniciar sesión (login simulado).
# Sin esta variable (o en "false"), el portal habla con VITE_GATEWAY_URL real.
VITE_USAR_MOCKS=true
