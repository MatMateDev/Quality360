# apps/gateway · variables de entorno. Copia a .env y complétalas.
# El .env no se versiona: aquí no hay valores, solo nombres.

# --- Proceso y portal -------------------------------------------------------
PORT=
# Orígenes del portal admitidos por CORS, separados por coma (5173 en
# desarrollo, 8080 en Compose).
PORTAL_ORIGENES=
# Saltos de proxy de confianza para el límite de tasa. 0 = el gateway está
# expuesto directamente.
CONFIAR_PROXY=

# --- Sesión de Supabase (identidad) -----------------------------------------
# Base de Supabase: de aquí salen el emisor y el JWKS.
SUPABASE_URL=
# Solo si el token se emite con una URL distinta a la que ve el contenedor.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=
SUPABASE_JWKS_URL=
# Respaldo local HS256 (llaves legacy de Supabase CLI). Sin esta variable, los
# tokens HS256 se rechazan. No usar en la nube.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_TOLERANCIA_S=

# --- Servicios internos -----------------------------------------------------
ORGANIZACION_URL=
CERTIFICACIONES_URL=

# --- Una URL por bloque compuesto (todas caen en ORGANIZACION_URL) ----------
# Apuntar una de estas a un puerto cerrado deja ese bloque `indisponible`
# mientras el resto sigue en `ok` (E1-B03#3, E1-F06#3).
FUENTE_RESUMEN_USUARIOS_URL=
FUENTE_RESUMEN_SUPERVISION_URL=
FUENTE_RESUMEN_EQUIPO_URL=
FUENTE_RESUMEN_SUPERVISOR_URL=
FUENTE_RESUMEN_HDU_URL=
# Checklist de Certificaciones; cae en CERTIFICACIONES_URL.
FUENTE_CHECKLIST_URL=

# --- Tiempos límite y límite de tasa ----------------------------------------
TIEMPO_LIMITE_FUENTE_MS=
TIEMPO_LIMITE_SERVICIO_MS=
LIMITE_TASA_VENTANA_MS=
LIMITE_TASA_MAX=
LIMITE_TASA_ESCRITURA_MAX=
