# services/certificaciones · variables de entorno. Copia a .env y complétalas.
PORT=3002

# Conexión a Postgres con el rol svc_certificaciones (infrastructure/db/001_esquemas_roles.sql).
# ?schema=certificaciones es obligatorio: el rol no tiene privilegios en `public`.
# Local: postgresql://svc_certificaciones:<password>@127.0.0.1:54322/postgres?schema=certificaciones
DATABASE_URL=

# JWKS para verificar la sesión (D4).
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Supabase Storage para evidencias y certificados (D20). Clave secreta: nunca en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# ResolutorDeAccesoRemoto (packages/auth-nest) y acceso a HDU: consulta a Organización.
ORGANIZACION_URL=

# URL pública del portal: se imprime en el certificado para verificar el folio (D21).
PORTAL_URL=http://localhost:5173

# Credencial de servicio a servicio (ADR 0007), para cuando otro servicio llame con `credencialServicio`.
X_Q360_SERVICIO_TOKEN=
