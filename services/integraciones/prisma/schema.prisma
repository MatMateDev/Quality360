// Quality360 · Integraciones (E5). Modelo de datos de la Corrida E5 (D94, D104, D111, D123, sección 6.1 del
// backlog E5 en docs/backlog/e5-integracion-jira.md y «Modelo de datos» en docs/arquitectura/decisiones-mvp.md).
//
// Las tablas viven en el esquema `integraciones` de Postgres (infrastructure/db/001_esquemas_roles.sql): la
// conexión se hace SIEMPRE con el rol `svc_integraciones`, cuya DATABASE_URL debe incluir
// `?schema=integraciones`. Sin llaves foráneas hacia otro esquema (regla no negociable 3): `celula_id`,
// `qe_responsable_id`, `sprint_respaldo_id`, `actor_id` e `id_historia` son UUID de Organización.
//
// Lo que Prisma no expresa vive en la migración 20261029000000_e5_integracion_jira:
//  - configuracion_jira: una sola fila (`id = 1`), `token_iv` de 12 bytes, `token_tag` de 16, catálogo de
//    `estado_conexion`. REVOKE DELETE.
//  - evento_configuracion: solo inserción (CHECK jsonb_typeof = 'array'). REVOKE UPDATE, DELETE.
//  - ejecucion_integracion: CHECK de catálogo (`origen`, `resultado`), `ejecucion_cierre_ck`
//    ((resultado = 'EN_CURSO') = (terminada_en IS NULL)), `ejecucion_contadores_ck` (suma = leídas al cerrar),
//    `ejecucion_archivo_ck`, `ejecucion_continuar_ck`; índice único parcial `ejecucion_en_curso_key`
//    ON ((true)) WHERE terminada_en IS NULL (una sola ejecución activa); disparador
//    `ejecucion_cerrada_inmutable` (BEFORE UPDATE). REVOKE DELETE.
//  - detalle_ejecucion: solo inserción; CHECK de `resultado`, `detalle_motivo_ck`, `detalle_historia_ck`;
//    disparador `detalle_solo_en_curso` (BEFORE INSERT). REVOKE UPDATE, DELETE.
//  - Índices: (iniciada_en DESC), (origen, iniciada_en DESC), (resultado, iniciada_en DESC),
//    (id_ejecucion, resultado, fila) e (id_historia).
//
// Lo que Prisma no expresa vive en la migración 20261102000000_e5_consulta_asignacion (E5 · consulta y asignación):
//  - consulta_jira: CHECK de catálogo (`estado`), `version >= 1`, `consulta_cierre_ck`
//    ((estado = 'ABIERTA') = (cerrada_en IS NULL)), formato de `proyecto_clave`, contadores >= 0 con
//    `total_filas <= 500` y `nuevas + cambiaron + sin_cambios + con_error = total_filas`; índice único parcial
//    `consulta_abierta_key` ON ((true)) WHERE estado = 'ABIERTA' (una sola abierta); disparador
//    `consulta_cerrada_inmutable` (BEFORE UPDATE). REVOKE DELETE, TRUNCATE.
//  - consulta_item: columna generada `codigo_normalizado` = upper(codigo) y UNIQUE (id_consulta, codigo_normalizado);
//    CHECK de catálogo (`grupo`, `prioridad`, `sprint_origen`), `motivo`, `cambios` solo en CAMBIO, asignación solo
//    en NUEVA, `marcada_valida` y `aplicada_marcada`; disparador `item_solo_consulta_abierta` (BEFORE INSERT OR
//    UPDATE). El DELETE se conserva: es la purga (D133). REVOKE TRUNCATE.
//  - ejecucion_integracion: CHECK de `fase`, `ejecucion_fase_ck`, `ejecucion_consulta_ck`,
//    `ejecucion_confirmacion_ck` y `ejecucion_contadores_ck` por fase (D141); el disparador
//    `ejecucion_cerrada_inmutable` suma `fase` y `consulta_id` a la identidad.
//  - detalle_ejecucion: CHECK `detalle_asignacion_ck` (objeto JSON).
//
// Lo que Prisma no expresa vive en la migración 20261106000000_e5_detalle_hdu (E5 · detalle y confirmación por HDU):
//  - consulta_item: CHECK `item_detalle_ck` (objeto JSON de hasta 40.960 bytes), `item_revision_ck` (>= 1),
//    `item_analista_auto_ck` (analista_auto implica analista_id), `item_ya_asignada_ck` (objeto JSON),
//    `item_alcance_aplicacion_ck` (LOTE o HDU) e `item_aplicacion_ck` (aplicada = alcance_aplicacion no nulo; sin aplicación
//    no hay quién ni cuándo); `item_hdu_ck` se reemplaza: una NUEVA puede guardar id_historia si está aplicada o ya_asignada.
//  - consulta_jira: CHECK `consulta_creadas_ck` (>= 0). `creadas` se conserva al purgar (D205).
//  - ejecucion_integracion: CHECK `ejecucion_alcance_ck`, `ejecucion_alcance_fase_ck` (HDU solo en CONFIRMACION) y
//    `ejecucion_alcance_hdu_ck` (HDU: leidas = 1 y ya cerrada); el disparador `ejecucion_cerrada_inmutable` suma `alcance`.
//  - detalle_ejecucion: el disparador `detalle_solo_en_curso` admite la única fila de una ejecución HDU ya cerrada.
//  Todas las funciones de disparador fijan su search_path (DEF-E5C-05).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Configuración de Jira: una sola fila. El API token se guarda cifrado con AES-256-GCM
/// (IV de 12 bytes, etiqueta de 16, dato asociado `q360:jira:token:v1`); lo único en claro son los
/// últimos 4 caracteres. Una prueba fallida solo actualiza `estado_conexion` y `ultima_prueba_*` (D112).
model ConfiguracionJira {
  id                   Int       @id @default(1) @db.SmallInt
  sitioUrl             String    @map("sitio_url") @db.VarChar(100)
  correo               String    @db.VarChar(150)
  proyectoClave        String    @map("proyecto_clave") @db.VarChar(10)
  /// Lista separada por comas, hasta 5 tipos.
  tiposIssue           String    @default("Story,Historia") @map("tipos_issue") @db.VarChar(200)
  /// `customfield_*` detectado con `GET /rest/api/3/field` (esquema gh-sprint).
  campoSprint          String?   @map("campo_sprint") @db.VarChar(30)
  /// `customfield_*` de «Acceptance Criteria» / «Criterios de aceptación», detectado al guardar la conexión (D199).
  campoCriterios       String?   @map("campo_criterios") @db.VarChar(30)
  celulaId             String    @map("celula_id") @db.Uuid
  qeResponsableId      String    @map("qe_responsable_id") @db.Uuid
  sprintRespaldoId     String    @map("sprint_respaldo_id") @db.Uuid
  tokenCifrado         Bytes     @map("token_cifrado")
  tokenIv              Bytes     @map("token_iv")
  tokenTag             Bytes     @map("token_tag")
  llaveVersion         Int       @default(1) @map("llave_version") @db.SmallInt
  tokenUltimos4        String    @map("token_ultimos4") @db.Char(4)
  estadoConexion       String    @map("estado_conexion") @db.VarChar(12)
  ultimaPruebaEn       DateTime? @map("ultima_prueba_en") @db.Timestamptz(6)
  ultimaPruebaCodigo   String?   @map("ultima_prueba_codigo") @db.VarChar(40)
  actualizadoPorId     String    @map("actualizado_por_id") @db.Uuid
  actualizadoPorNombre String    @map("actualizado_por_nombre") @db.VarChar(150)
  actualizadoEn        DateTime  @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  @@map("configuracion_jira")
}

/// Cambios de configuración (D111). Solo inserción. `campos_cambiados` son nombres de campo, nunca valores.
model EventoConfiguracion {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @map("id_evento") @db.Uuid
  actorId         String   @map("actor_id") @db.Uuid
  actorNombre     String   @map("actor_nombre") @db.VarChar(150)
  fecha           DateTime @default(now()) @db.Timestamptz(6)
  camposCambiados Json     @map("campos_cambiados")
  tokenCambiado   Boolean  @map("token_cambiado")
  /// `OK` o el código de error de la prueba que acompañó al guardado.
  resultadoPrueba String   @map("resultado_prueba") @db.VarChar(40)

  @@index([fecha(sort: Desc)], map: "evento_configuracion_fecha_idx")
  @@map("evento_configuracion")
}

/// Una sincronización o importación (D103, D104). Se inserta `EN_CURSO` y se cierra una sola vez.
model EjecucionIntegracion {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @map("id_ejecucion") @db.Uuid
  origen             String    @db.VarChar(5)
  estricto           Boolean   @default(false)
  vincularExistentes Boolean   @default(false) @map("vincular_existentes")
  actorId            String    @map("actor_id") @db.Uuid
  actorNombre        String    @map("actor_nombre") @db.VarChar(150)
  actorRol           String    @map("actor_rol") @db.VarChar(30)
  iniciadaEn         DateTime  @default(now()) @map("iniciada_en") @db.Timestamptz(6)
  terminadaEn        DateTime? @map("terminada_en") @db.Timestamptz(6)
  duracionMs         Int?      @map("duracion_ms")
  resultado          String    @db.VarChar(12)
  leidas             Int       @default(0)
  creadas            Int       @default(0)
  actualizadas       Int       @default(0)
  omitidas           Int       @default(0)
  conError           Int       @default(0) @map("con_error")
  conAdvertencias    Int       @default(0) @map("con_advertencias")
  reintentos429      Int       @default(0) @map("reintentos_429")
  /// Solo códigos y mensajes fijos del servicio; nunca texto de Jira.
  codigoError        String?   @map("codigo_error") @db.VarChar(40)
  mensajeError       String?   @map("mensaje_error") @db.VarChar(300)
  proyectoClave      String?   @map("proyecto_clave") @db.VarChar(10)
  sitioHost          String?   @map("sitio_host") @db.VarChar(100)
  archivoNombre      String?   @map("archivo_nombre") @db.VarChar(150)
  archivoTamano      Int?      @map("archivo_tamano")
  /// SHA-256 del contenido recibido. El contenido no se guarda (D104).
  archivoHuella      String?   @map("archivo_huella") @db.Char(64)
  hayMas             Boolean   @default(false) @map("hay_mas")
  continuarDesde     String?   @map("continuar_desde") @db.VarChar(40)
  /// Esperas por 429: `[{tipo, espera_ms, fecha}]`.
  eventos            Json?
  /// `DIRECTA` (importaciones de archivo y sincronizaciones anteriores a D132), `CONSULTA` o `CONFIRMACION` (D141).
  fase               String    @default("DIRECTA") @db.VarChar(12)
  consultaId         String?   @map("consulta_id") @db.Uuid
  /// Solo fase `CONSULTA`: filas de la tanda por grupo (D141).
  nuevas             Int       @default(0)
  cambiaron          Int       @default(0)
  sinCambios         Int       @default(0) @map("sin_cambios")
  /// `LOTE` («Confirmar marcadas» y toda ejecución que no es de una sola fila) o `HDU` («Confirmar asignación», D206).
  alcance            String    @default("LOTE") @db.VarChar(4)

  consulta ConsultaJira?      @relation(fields: [consultaId], references: [id], onDelete: Restrict)
  detalle  DetalleEjecucion[]

  @@index([iniciadaEn(sort: Desc)], map: "ejecucion_integracion_iniciada_idx")
  @@index([origen, iniciadaEn(sort: Desc)], map: "ejecucion_integracion_origen_idx")
  @@index([resultado, iniciadaEn(sort: Desc)], map: "ejecucion_integracion_resultado_idx")
  @@index([fase, iniciadaEn(sort: Desc)], map: "ejecucion_integracion_fase_idx")
  @@index([alcance, iniciadaEn(sort: Desc)], map: "ejecucion_integracion_alcance_idx")
  @@map("ejecucion_integracion")
}

/// Una fila de archivo o una issue de Jira. Solo inserción. Sin llave foránea de `id_historia` (es de Organización).
model DetalleEjecucion {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @map("id_detalle") @db.Uuid
  ejecucionId  String  @map("id_ejecucion") @db.Uuid
  /// Número de fila de datos del archivo (la primera es 1) o posición de la issue.
  fila         Int
  codigo       String? @db.VarChar(60)
  titulo       String? @db.VarChar(200)
  historiaId   String? @map("id_historia") @db.Uuid
  /// `ACTUALIZADA` tiene 11 caracteres: la sección 6.1 del backlog E5 decía varchar(10) y no cabe.
  resultado    String  @db.VarChar(12)
  motivo       String? @db.VarChar(40)
  mensaje      String? @db.VarChar(200)
  advertencias Json?
  /// `{campo: {antes, despues}}`, valores recortados a 200 caracteres.
  cambios      Json?
  /// Estado y responsable de la issue de Jira; solo informativo.
  referencia   Json?
  /// Solo fase `CONFIRMACION` y filas `CREADA`: nombres de célula, QE, analista y sprint (D141).
  asignacion   Json?

  ejecucion EjecucionIntegracion @relation(fields: [ejecucionId], references: [id], onDelete: Restrict)

  @@unique([ejecucionId, fila], map: "detalle_ejecucion_fila_key")
  @@index([ejecucionId, resultado, fila], map: "detalle_ejecucion_resultado_idx")
  @@index([historiaId], map: "detalle_ejecucion_historia_idx")
  @@map("detalle_ejecucion")
}

/// Una consulta de Jira (D133, D134): borrador revisable. Una sola `ABIERTA` a la vez. Al cerrarse (confirmada,
/// reemplazada, vencida o descartada) sus filas se purgan y quedan solo la cabecera y los contadores.
model ConsultaJira {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @map("id_consulta") @db.Uuid
  estado                 String    @db.VarChar(12)
  /// Sube con cada cambio de filas o de estado (D139).
  version                Int       @default(1)
  creadaPorId            String    @map("creada_por_id") @db.Uuid
  creadaPorNombre        String    @map("creada_por_nombre") @db.VarChar(150)
  creadaEn               DateTime  @default(now()) @map("creada_en") @db.Timestamptz(6)
  /// Hora de la última llamada a Jira + INTEGRACIONES_CONSULTA_VIGENCIA_MS.
  venceEn                DateTime  @map("vence_en") @db.Timestamptz(6)
  cerradaEn              DateTime? @map("cerrada_en") @db.Timestamptz(6)
  cerradaPorId           String?   @map("cerrada_por_id") @db.Uuid
  cerradaPorNombre       String?   @map("cerrada_por_nombre") @db.VarChar(150)
  proyectoClave          String    @map("proyecto_clave") @db.VarChar(10)
  sitioHost              String    @map("sitio_host") @db.VarChar(100)
  hayMas                 Boolean   @default(false) @map("hay_mas")
  continuarDesde         String?   @map("continuar_desde") @db.VarChar(40)
  /// Instantánea del destino de Conexión (D146). UUID de Organización, sin llave foránea.
  sugerenciaCelulaId     String?   @map("sugerencia_celula_id") @db.Uuid
  sugerenciaQeId         String?   @map("sugerencia_qe_id") @db.Uuid
  sprintRespaldoId       String?   @map("sprint_respaldo_id") @db.Uuid
  /// Nombres de la instantánea (D146): así leer la consulta no llama a Organización.
  sugerenciaCelulaNombre String?   @map("sugerencia_celula_nombre") @db.VarChar(120)
  sugerenciaQeNombre     String?   @map("sugerencia_qe_nombre") @db.VarChar(150)
  sprintRespaldoNombre   String?   @map("sprint_respaldo_nombre") @db.VarChar(120)
  /// Contadores: se conservan al purgar las filas.
  totalFilas             Int       @default(0) @map("total_filas")
  nuevas                 Int       @default(0)
  cambiaron              Int       @default(0)
  sinCambios             Int       @default(0) @map("sin_cambios")
  conError               Int       @default(0) @map("con_error")
  conAdvertencias        Int       @default(0) @map("con_advertencias")
  descartadas            Int       @default(0)
  /// HDU creadas desde la consulta, por fila o en lote. Se conserva al purgar (D205).
  creadas                Int       @default(0)

  items      ConsultaItem[]
  ejecuciones EjecucionIntegracion[]

  @@index([creadaEn(sort: Desc)], map: "consulta_jira_creada_idx")
  @@map("consulta_jira")
}

/// Una fila de la consulta: solo lo mapeado de cada issue (D133), nunca la respuesta cruda de Jira.
/// `consulta_item` es la única tabla de Integraciones con DELETE (la purga). Sin llaves foráneas hacia otro esquema:
/// `id_historia`, `celula_id`, `qe_id`, `analista_id` y `sprint_id` son UUID de Organización.
model ConsultaItem {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @map("id_item") @db.Uuid
  consultaId        String    @map("id_consulta") @db.Uuid
  posicion          Int
  grupo             String    @db.VarChar(11)
  codigo            String?   @db.VarChar(60)
  titulo            String?   @db.VarChar(200)
  descripcion       String?   @db.VarChar(1000)
  prioridad         String?   @db.VarChar(7)
  sprintJira        String?   @map("sprint_jira") @db.VarChar(120)
  referencia        Json?
  advertencias      Json?
  motivo            String?   @db.VarChar(40)
  historiaId        String?   @map("id_historia") @db.Uuid
  origenHdu         String?   @map("origen_hdu") @db.VarChar(6)
  estadoHdu         String?   @map("estado_hdu") @db.VarChar(20)
  qeHduNombre       String?   @map("qe_hdu_nombre") @db.VarChar(150)
  cambios           Json?
  celulaId          String?   @map("celula_id") @db.Uuid
  qeId              String?   @map("qe_id") @db.Uuid
  analistaId        String?   @map("analista_id") @db.Uuid
  sprintId          String?   @map("sprint_id") @db.Uuid
  celulaNombre      String?   @map("celula_nombre") @db.VarChar(120)
  qeNombre          String?   @map("qe_nombre") @db.VarChar(150)
  analistaNombre    String?   @map("analista_nombre") @db.VarChar(150)
  sprintNombre      String?   @map("sprint_nombre") @db.VarChar(120)
  sprintOrigen      String?   @map("sprint_origen") @db.VarChar(8)
  avisoSinLider     Boolean   @default(false) @map("aviso_sin_lider")
  marcada           Boolean   @default(false)
  aplicada          Boolean   @default(false)
  asignadoPorId     String?   @map("asignado_por_id") @db.Uuid
  asignadoPorNombre String?   @map("asignado_por_nombre") @db.VarChar(150)
  asignadoEn        DateTime? @map("asignado_en") @db.Timestamptz(6)
  /// Detalle saneado de la issue (D198): objeto de hasta 40 KB, solo mientras la consulta está abierta. Nunca se registra.
  detalle           Json?
  /// Versión de la fila: sube con cada cambio de datos (D202).
  revision          Int       @default(1)
  /// El analista lo puso el servidor por ser el único del equipo del QE (D201).
  analistaAuto      Boolean   @default(false) @map("analista_auto")
  /// Toma atómica de «Confirmar asignación» y del lote; vence a los INTEGRACIONES_TOMA_FILA_MS (D202).
  aplicandoDesde    DateTime? @map("aplicando_desde") @db.Timestamptz(6)
  /// `{idHistoria, qe, analista}` de la HDU que ya existe (D204).
  yaAsignada        Json?     @map("ya_asignada")
  alcanceAplicacion String?   @map("alcance_aplicacion") @db.VarChar(4)
  aplicadoPorId     String?   @map("aplicado_por_id") @db.Uuid
  aplicadoPorNombre String?   @map("aplicado_por_nombre") @db.VarChar(150)
  aplicadoEn        DateTime? @map("aplicado_en") @db.Timestamptz(6)

  consulta ConsultaJira @relation(fields: [consultaId], references: [id], onDelete: Restrict)

  @@unique([consultaId, posicion], map: "consulta_item_posicion_key")
  @@index([consultaId, grupo, posicion], map: "consulta_item_grupo_idx")
  @@map("consulta_item")
}
