# services/integraciones · variables de entorno. Copia a .env y complétalas. No guardes valores reales aquí.
PORT=3004

# Conexión a Postgres con el rol svc_integraciones (infrastructure/db/001_esquemas_roles.sql).
# ?schema=integraciones es obligatorio: el rol no tiene privilegios en `public`.
# Local: postgresql://svc_integraciones:<password>@127.0.0.1:54322/postgres?schema=integraciones
DATABASE_URL=

# JWKS para verificar la sesión (D4).
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Organización: resuelve el acceso (GET /v1/interno/acceso) y recibe las HDU (upsert). En producción,
# si falta, /v1/* responde 503 y /health sigue en 200.
ORGANIZACION_URL=http://localhost:3001
ORGANIZACION_TIMEOUT_MS=5000

# Llave de cifrado del API token (AES-256-GCM): 32 bytes aleatorios en Base64 (44 caracteres).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si falta o es inválida, el servicio arranca y solo cifrar/descifrar responde 503 (D128).
INTEGRACIONES_LLAVE_CIFRADO=

# Presupuesto de una sincronización/importación y límites hacia Jira (D96, D114).
INTEGRACIONES_PRESUPUESTO_MS=8000
JIRA_TIEMPO_LIMITE_MS=3000
JIRA_ESPERA_MAX_429_MS=3000
JIRA_TOPE_ISSUES=100
INTEGRACIONES_EN_CURSO_MAX_MS=300000

# Consulta de Jira (E5, D134/D135). Vacío = por defecto: vigencia 86400000 (24 h), tope 500 filas.
INTEGRACIONES_CONSULTA_VIGENCIA_MS=
INTEGRACIONES_CONSULTA_TOPE_ITEMS=

# Detalle y confirmación por HDU (D196, D202). Tamaño de página de search/jql: 50 por defecto, entre 10 y 100 (fuera de rango = 50);
# bájalo a 25 si las descripciones largas no caben en los 3 s por petición. La toma de una fila dura 30 s (en pruebas de carrera, 2000).
INTEGRACIONES_JIRA_TAMANO_PAGINA=50
INTEGRACIONES_TOMA_FILA_MS=30000

# Solo pruebas: admite http://127.0.0.1:<puerto> como sitio de Jira. Se ignora con NODE_ENV=production (D95).
INTEGRACIONES_PERMITIR_HOST_PRUEBA=false

# Conexión con Jira por OAuth 2.0 (3LO) (ADR 0019, D216). Opcionales: sin las tres primeras «Conectar con Jira» queda
# deshabilitado y el API token sigue funcionando. Guía: docs/arquitectura/guia-oauth-atlassian.md. No guardes valores reales aquí.
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
# https://<portal>/admin/integraciones/jira/oauth/retorno (ruta exacta, sin parámetros). Local: http://localhost:5173/admin/integraciones/jira/oauth/retorno
JIRA_OAUTH_REDIRECT_URI=
# Solo pruebas, con INTEGRACIONES_PERMITIR_HOST_PRUEBA=true y fuera de producción (el Atlassian simulado). Vacío = los hosts fijos de Atlassian.
JIRA_OAUTH_URL_AUTORIZACION=
JIRA_OAUTH_URL_API=

# Consulta de Jira (D134, D135): vigencia desde la ultima llamada a Jira y tope de filas.
INTEGRACIONES_CONSULTA_VIGENCIA_MS=86400000
INTEGRACIONES_CONSULTA_TOPE_ITEMS=500
