# services/integraciones · variables de entorno. Copia a .env y complétalas. No guardes valores reales aquí.
PORT=3004

# Conexión a Postgres con el rol svc_integraciones (infrastructure/db/001_esquemas_roles.sql).
# ?schema=integraciones es obligatorio: el rol no tiene privilegios en `public`.
# Local: postgresql://svc_integraciones:<password>@127.0.0.1:54322/postgres?schema=integraciones
DATABASE_URL=

# JWKS para verificar la sesión (D4).
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Organización: resuelve el acceso (GET /v1/interno/acceso) y recibe las HDU (upsert). En producción,
# si falta, /v1/* responde 503 y /health sigue en 200.
ORGANIZACION_URL=http://localhost:3001
ORGANIZACION_TIMEOUT_MS=5000

# Llave de cifrado del API token (AES-256-GCM): 32 bytes aleatorios en Base64 (44 caracteres).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si falta o es inválida, el servicio arranca y solo cifrar/descifrar responde 503 (D128).
INTEGRACIONES_LLAVE_CIFRADO=

# Presupuesto de una sincronización/importación y límites hacia Jira (D96, D114).
INTEGRACIONES_PRESUPUESTO_MS=8000
JIRA_TIEMPO_LIMITE_MS=3000
JIRA_ESPERA_MAX_429_MS=3000
JIRA_TOPE_ISSUES=100
INTEGRACIONES_EN_CURSO_MAX_MS=300000

# Solo pruebas: admite http://127.0.0.1:<puerto> como sitio de Jira. Se ignora con NODE_ENV=production (D95).
INTEGRACIONES_PERMITIR_HOST_PRUEBA=false
