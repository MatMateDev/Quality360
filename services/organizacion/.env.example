# services/organizacion · variables de entorno. Copia a .env y complétalas.
# El .env no se versiona.

PORT=3001

# Conexión a Postgres con el rol svc_organizacion (infrastructure/db/001_esquemas_roles.sql).
# El parámetro ?schema=organizacion es obligatorio: el rol no tiene privilegios
# en el esquema `public`, así que Prisma debe apuntar explícitamente al suyo.
# Local: postgresql://svc_organizacion:<password>@127.0.0.1:54322/postgres?schema=organizacion
DATABASE_URL=

# Base de Supabase: JWKS para verificar la sesión (D4) y Admin API para altas
# de usuario (invitación) y compensación (alta de usuario · E1-B07#1, D3).
SUPABASE_URL=
# service_role, SOLO en este servicio (ver docs/arquitectura/decisiones-mvp.md D3).
SUPABASE_SERVICE_ROLE_KEY=
# Respaldo local HS256 (llaves legacy de Supabase CLI). Opcional: docker-compose
# no la pasa a este servicio (solo usa JWKS), pero es útil para depurar en local.
SUPABASE_JWT_SECRET=

# Credencial de servicio a servicio (ADR 0007): la valida este servicio en las
# rutas que declaran `x-roles: [SERVICIO]` o que aceptan `credencialServicio`.
X_Q360_SERVICIO_TOKEN=
# Habilita /v1/interno/carga/*. En false por defecto.
PERMITIR_CARGA_SEMILLA=false
