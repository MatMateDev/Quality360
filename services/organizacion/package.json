{
  "name": "@quality360/organizacion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quality360 · Organización y seguimiento: usuarios, roles, supervisión, células, sprints y HDU (NestJS + Prisma). Dueño: q360-backend.",
  "license": "LicenseRef-Capstone-Duoc-UC",
  "main": "./dist/main.js",
  "imports": {
    "#prisma": {
      "types": "./generated/prisma/index.d.ts",
      "default": "./generated/prisma/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "build:pruebas": "prisma generate && tsc -p tsconfig.pruebas.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "node --env-file-if-exists=.env dist/main.js",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "test": "npm run build:pruebas && node --env-file-if-exists=.env.test --test --test-concurrency=1 \"build-pruebas/test/**/*.test.js\"",
    "test:dominio": "npm run build:pruebas && node --test \"build-pruebas/test/dominio/**/*.test.js\""
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@prisma/client": "^6.19.3",
    "@quality360/auth-nest": "*",
    "@supabase/supabase-js": "^2.116.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.5",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3"
  }
}
