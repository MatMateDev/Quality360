# services/impedimentos · variables de entorno. Copia a .env y complétalas.
PORT=3003

# Conexión a Postgres con el rol svc_impedimentos (infrastructure/db/001_esquemas_roles.sql).
# ?schema=impedimentos es obligatorio: el rol no tiene privilegios en `public`.
# Local: postgresql://svc_impedimentos:<password>@127.0.0.1:54322/postgres?schema=impedimentos
DATABASE_URL=

# JWKS para verificar la sesión (D4).
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# ResolutorDeAccesoRemoto (packages/auth-nest): consulta el rol/ámbito a Organización.
ORGANIZACION_URL=

# Certificaciones (avance y ciclo activo, D86) y tiempos límite en ms.
CERTIFICACIONES_URL=http://localhost:3002
ORGANIZACION_TIMEOUT_MS=5000
CERTIFICACIONES_TIMEOUT_MS=2000

# Umbrales del riesgo sugerido (D67).
RIESGO_DIAS_IMPEDIMENTO_ALTO=5
RIESGO_DIAS_SPRINT_ALTO=3
RIESGO_AVANCE_ALTO=70
RIESGO_DIAS_SPRINT_MEDIO=7
RIESGO_AVANCE_MEDIO=50

# Solo pruebas (AAAA-MM-DD). Se ignora con NODE_ENV=production (D68, D90).
# Q360_FECHA_REFERENCIA=

EXPORTACION_LIMITE_FILAS=50000

# Credencial de servicio a servicio (ADR 0007) y habilitación de /v1/interno/carga/* (semilla E4).
X_Q360_SERVICIO_TOKEN=
PERMITIR_CARGA_SEMILLA=false
