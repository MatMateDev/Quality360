# services/indicadores · variables de entorno. Copia a .env y complétalas. No guardes valores reales aquí.
# Ninguna impide el arranque: lo que falte deja inhabilitada su capacidad (ver README).
PORT=3005

# Conexión a Postgres con el rol svc_indicadores (infrastructure/db/001_esquemas_roles.sql).
# ?schema=indicadores es obligatorio: el rol no tiene privilegios en `public`.
# Local: postgresql://svc_indicadores:<password>@127.0.0.1:54322/postgres?schema=indicadores
DATABASE_URL=

# JWKS para verificar la sesión (D4).
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Fuentes de datos (D154). En producción, sin ORGANIZACION_URL solo /health responde.
ORGANIZACION_URL=http://localhost:3001
CERTIFICACIONES_URL=http://localhost:3002
IMPEDIMENTOS_URL=http://localhost:3003
# Tiempo por llamada a una fuente y, en el snapshot, con 1 reintento (D178).
INDICADORES_FUENTE_TIMEOUT_MS=2000
INDICADORES_SNAPSHOT_TIMEOUT_MS=8000

# Cron (D178): Vercel envía Authorization: Bearer <CRON_SECRET>. Sin valor, la ruta responde siempre 401.
CRON_SECRET=
# Credencial hacia las tres rutas de lectura global (D177); el mismo valor va en Organización,
# Certificaciones e Impedimentos. Sin valor, el snapshot queda FALLIDA (CONFIGURACION_INVALIDA).
INDICADORES_SERVICIO_TOKEN=

# Parámetros (D172).
INDICADORES_UMBRAL_DEFECTO=5
INDICADORES_UMBRAL_MIN=1
INDICADORES_UMBRAL_MAX=50
INDICADORES_TOPE_HDU=1000
EXPORTACION_LIMITE_FILAS=50000
EXPORTACION_PDF_LIMITE_FILAS=200

# Solo pruebas: fija «ahora» (AAAA-MM-DD o ISO). Se ignora con NODE_ENV=production (D172).
# Q360_FECHA_REFERENCIA=

# Gancho de prueba POST /v1/interno/carga/snapshots (D184): credencial de la semilla y habilitación.
X_Q360_SERVICIO_TOKEN=
PERMITIR_CARGA_SEMILLA=false
