{
  "name": "@quality360/auth-nest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Verificación de la sesión de Supabase y guards de identidad y rol para NestJS. Sin lógica de negocio.",
  "license": "LicenseRef-Capstone-Duoc-UC",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:pruebas": "tsc -p tsconfig.pruebas.json",
