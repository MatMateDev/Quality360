    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/testing": "^11.2.5",
    "@types/node": "^24.13.5",
    "@types/supertest": "^7.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3"
  }
